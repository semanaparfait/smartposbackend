# Settings the SmartPOS server reads. Copy to .env and fill in; never commit .env.

NODE_ENV=production
PORT=3050
PREFIX=api/v1
BACKEND_SOURCE=https://api.your-domain.rw

# Database. The running server can use a user that only reads and writes rows
# (see src/database/roles.sql); migrations use the owner.
PROD_DATABASE_URL=postgres://smartpos_app:PASSWORD@HOST:5432/DB?sslmode=verify-full
PROD_MIGRATION_DATABASE_URL=postgres://OWNER:PASSWORD@HOST:5432/DB?sslmode=verify-full
# off = the server never changes tables itself; run `npm run migration:run`.
MIGRATIONS_RUN=off
# Optional: path to your database provider's CA certificate.
DB_SSL_CA=
DB_POOL_MAX=10

# Sign-in keys. A long random secret (e.g. 64 characters).
JWT_ACCESS_SECRET=
# The app's sign-in key lifetime, e.g. 12h.
ACCESS_EXPIRY=12h
# The website's short sign-in key and how long its cookie sign-in lasts.
WEB_ACCESS_EXPIRY=30m
REFRESH_DAYS=30
# lax when the API is on the website's domain (api.your-domain.rw), none otherwise.
COOKIE_SAMESITE=lax
# Optional, e.g. .your-domain.rw
COOKIE_DOMAIN=

# Websites allowed to call the API from a browser, comma separated.
CORS_ORIGINS=https://your-domain.rw,https://www.your-domain.rw
# Proxies in front of the server (most hosts: 1).
TRUST_PROXY=1
# on = show the API documentation in production too.
SWAGGER=

# Email (forgot password, new accounts, inbox alerts).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SmartPOS <no-reply@your-domain.rw>
MAIL_ADMIN=
WEBSITE_URL=https://your-domain.rw

# Error tracking (sentry.io project DSN).
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1

# Image storage (Cloudinary).
CLOUD_NAME=
API_KEY=
API_SECRET=

# The first super admin account, created by the seeder.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
